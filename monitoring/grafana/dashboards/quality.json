{
  "uid": "carbon-quality",
  "title": "Forecast quality",
  "tags": [
    "carbon-forecast"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now+2d"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Model MAE, last 14 scored days (gCO\u2082/kWh)",
      "description": "Retraining triggers above 1.3 x 20.65 = 26.8",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select avg(mae) as model from (select mae from daily_scores where method = 'model' order by target_day desc limit 14) t"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "NESO day-ahead MAE, same days",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select avg(mae) as neso from (select mae from daily_scores where method = 'neso' order by target_day desc limit 14) t"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Baseline MAE, same days",
