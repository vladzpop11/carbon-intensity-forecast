            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select avg(mae) as baseline from (select mae from daily_scores where method = 'baseline' order by target_day desc limit 14) t"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scored days",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select count(distinct target_day) as days from daily_scores"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily MAE by method",
      "description": "Mean absolute error of each day's forecast, issued at 09:00 UTC the day before",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select target_day::timestamp as time, method as metric, mae as value from daily_scores order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rolling 14-day MAE by method",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select target_day::timestamp as time, method as metric, avg(mae) over (partition by method order by target_day rows between 13 preceding and current row) as value from daily_scores order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Forecasts and actual values, last 3 days",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select f.target_time as time, f.method as metric, f.value from forecasts f where f.target_time > now() - interval '3 days' union all select period_start, 'actual', actual from actuals where period_start > now() - interval '3 days' and actual is not null order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Input drift share (PSI against the same season in earlier years)",
      "description": "A diagnostic, not a retraining trigger (README: why)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "select run_day::timestamp as time, share from drift order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Retraining decisions",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select run_at, coalesce(trigger, '-') as trigger, scored_days, round(rolling_mae::numeric, 1) as rolling_mae, model_version, model_age_days, reason from decisions order by run_at desc limit 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
